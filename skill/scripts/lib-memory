#!/usr/bin/env bash
# Shared memory-tier helpers for Gilfoyle scripts
# Source this file: source "$SCRIPT_DIR/lib-memory"

# resolve_project_memory_dir [personal-memory-dir]
#
# Locates the project tier: a memory directory with the personal layout (kb/...)
# that lives in the project's own repository and is committed with it.
#
#   1. $GILFOYLE_PROJECT_MEMORY_DIR, when set. It is authoritative: if it names
#      no usable directory that is an error, not a cue to look somewhere else.
#      The path is yours, so it is followed through symlinks as given.
#   2. <git-toplevel>/.gilfoyle/memory, found from the current directory. Every
#      component below the toplevel came out of the checkout: none may be a symlink.
#
# Either way, nothing inside the tier may be a symlink. A committed link reads and
# appends wherever the repo points it (kb/facts.md -> ~/.ssh/id_ed25519) while
# git status stays clean.
#
# The tier exists only if its kb/ directory does. This never creates anything.
#
# Sets PROJECT_MEMORY_DIR (canonical when ok, empty if nothing to point at),
# PROJECT_MEMORY_LINK (the offending path, for "symlink") and PROJECT_MEMORY_STATUS:
#   ok | env-missing | not-git | default-missing | same-as-personal | inside-personal |
#   contains-personal | org-overlap | symlink
# Returns 0 only for "ok". Callers run under set -e: call it from an `if`.
resolve_project_memory_dir() {
  local personal_dir="${1:-}"
  local configured="${GILFOYLE_PROJECT_MEMORY_DIR:-}"
  local relative=".gilfoyle/memory"
  local missing_status="" toplevel="" canonical="" links="" personal_canonical=""

  PROJECT_MEMORY_DIR=""
  PROJECT_MEMORY_LINK=""
  PROJECT_MEMORY_PERSONAL=""
  PROJECT_MEMORY_STATUS="ok"

  if [[ -n "$configured" ]]; then
    PROJECT_MEMORY_DIR="${configured%/}"
    missing_status="env-missing"
  else
    toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || toplevel=""
    if [[ -z "$toplevel" ]]; then
      PROJECT_MEMORY_STATUS="not-git"
      return 1
    fi
    PROJECT_MEMORY_DIR="$toplevel/$relative"
    missing_status="default-missing"
    if _project_memory_link "$toplevel/${relative%/*}" || _project_memory_link "$PROJECT_MEMORY_DIR"; then
      return 1
    fi
  fi

  if _project_memory_link "$PROJECT_MEMORY_DIR/kb"; then
    return 1
  fi
  if [[ ! -d "$PROJECT_MEMORY_DIR/kb" ]]; then
    PROJECT_MEMORY_STATUS="$missing_status"
    return 1
  fi

  # Pointing the tier at the personal directory would read it twice and let
  # sleep rewrite it. It is the personal tier; don't pretend otherwise.
  if [[ -n "$personal_dir" ]] && [[ "$PROJECT_MEMORY_DIR" -ef "$personal_dir" ]]; then
    PROJECT_MEMORY_STATUS="same-as-personal"
    return 1
  fi

  # Canonical from here on: find does not descend into a symlinked starting point,
  # and the path everyone prints is where the bytes actually land.
  if ! canonical=$(CDPATH='' cd -P -- "$PROJECT_MEMORY_DIR" && pwd -P); then
    PROJECT_MEMORY_STATUS="$missing_status"
    return 1
  fi
  PROJECT_MEMORY_DIR="$canonical"

  # Anything under the personal directory is an org tier (orgs/<name>) or part of the
  # personal one, aliases included. sleep and mem-share commit and push org tiers, and
  # project writes must not ride along.
  if [[ -n "$personal_dir" ]] && personal_canonical=$(_canonical_path "$personal_dir"); then
    case "$PROJECT_MEMORY_DIR/" in
      "$personal_canonical"/*)
        PROJECT_MEMORY_PERSONAL="$personal_canonical"
        PROJECT_MEMORY_STATUS="inside-personal"
        return 1
        ;;
    esac
    # The other way round, the personal tier (and config.toml next to it) would be read
    # as project memory, rewritten by sleep and staged with the project.
    case "$personal_canonical/" in
      "$PROJECT_MEMORY_DIR"/*)
        PROJECT_MEMORY_PERSONAL="$personal_canonical"
        PROJECT_MEMORY_STATUS="contains-personal"
        return 1
        ;;
    esac
  fi

  # An org directory that resolves onto, into or around the project tier (a symlink in
  # orgs/ is enough) makes sleep and mem-share rewrite and push project files as org memory.
  # Enumerated through the canonical personal path: the raw one may run through a
  # directory that does not exist yet (missing/../alias).
  if [[ -n "$personal_canonical" ]] && [[ -d "$personal_canonical/orgs" ]]; then
    local org_dir org_canonical
    # Hidden names too: org-add, mem-write --org and mem-share take ".team" by path.
    for org_dir in "$personal_canonical"/orgs/* "$personal_canonical"/orgs/.[!.]* "$personal_canonical"/orgs/..?*; do
      [[ -d "$org_dir" ]] || continue
      org_canonical=$(CDPATH='' cd -P -- "$org_dir" 2>/dev/null && pwd -P) || continue
      case "$PROJECT_MEMORY_DIR/" in
        "$org_canonical"/*) ;;
        *) case "$org_canonical/" in
             "$PROJECT_MEMORY_DIR"/*) ;;
             *) continue ;;
           esac ;;
      esac
      PROJECT_MEMORY_PERSONAL="$org_dir"
      PROJECT_MEMORY_LINK="$org_canonical"
      PROJECT_MEMORY_STATUS="org-overlap"
      return 1
    done
  fi

  # .git is skipped: a checkout never delivers it, and nothing reads or writes there.
  links=$(find "$PROJECT_MEMORY_DIR" -name .git -prune -o -type l -print 2>/dev/null) || true
  if [[ -n "$links" ]]; then
    PROJECT_MEMORY_LINK="${links%%$'\n'*}"
    PROJECT_MEMORY_STATUS="symlink"
    return 1
  fi

  return 0
}

# _canonical_path <path>
# Physical path of <path>, which need not exist yet. Walks it one component at a time
# and resolves everything that exists, so a link a ".." brings back into reach is
# followed too. The overlap checks must not wait for the personal directory to be
# created: config.toml is already sitting next to where it will be.
_canonical_path() {
  local path="$1" result="" component
  [[ "$path" == /* ]] || path="$PWD/$path"
  while [[ -n "$path" ]]; do
    path="${path#/}"
    component="${path%%/*}"
    path="${path#"$component"}"
    case "$component" in
      ''|.) continue ;;
      ..) result="${result%/*}" ;;
      *) result="$result/$component" ;;
    esac
    if [[ -n "$result" ]] && [[ -d "$result" ]]; then
      result=$(CDPATH='' cd -P -- "$result" 2>/dev/null && pwd -P) || return 1
      [[ "$result" != "/" ]] || result=""
    fi
  done
  printf '%s\n' "${result:-/}"
}

# _project_memory_link <path>
# True (and records it) if <path> is a symlink, dangling or not.
_project_memory_link() {
  if [[ -L "$1" ]]; then
    PROJECT_MEMORY_LINK="$1"
    PROJECT_MEMORY_STATUS="symlink"
    return 0
  fi
  return 1
}

# project_memory_misconfigured
# True if the last resolve_project_memory_dir found a tier it refuses to use, as
# opposed to there being none. Worth a warning; silence would look like "no tier".
project_memory_misconfigured() {
  case "${PROJECT_MEMORY_STATUS:-}" in
    env-missing|same-as-personal|inside-personal|contains-personal|org-overlap|symlink) return 0 ;;
    *) return 1 ;;
  esac
}

# project_overlaps_org <org-dir>
# After resolve_project_memory_dir: true if <org-dir> resolves onto, into or around the
# project tier. Org tools (mem-write --org, mem-share, mem-sync, sleep) leave such an org
# alone: what they would rewrite, commit, pull or push is the project's checkout.
project_overlaps_org() {
  case "${PROJECT_MEMORY_STATUS:-}" in ok|org-overlap) ;; *) return 1 ;; esac
  [[ -n "${PROJECT_MEMORY_DIR:-}" ]] || return 1
  local org_canonical
  org_canonical=$(CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P) || return 1
  case "$org_canonical/" in "$PROJECT_MEMORY_DIR"/*) return 0 ;; esac
  case "$PROJECT_MEMORY_DIR/" in "$org_canonical"/*) return 0 ;; esac
  return 1
}

# project_memory_problem
# Explains why the last resolve_project_memory_dir failed. One indented line per fact.
project_memory_problem() {
  case "${PROJECT_MEMORY_STATUS:-}" in
    env-missing)
      echo "  GILFOYLE_PROJECT_MEMORY_DIR is set to '$PROJECT_MEMORY_DIR', which has no kb/ directory."
      echo "  Create it (mkdir -p '$PROJECT_MEMORY_DIR/kb') or unset the variable."
      ;;
    not-git)
      echo "  Not inside a git repository, and GILFOYLE_PROJECT_MEMORY_DIR is not set."
      echo "  Run from inside the project, or point GILFOYLE_PROJECT_MEMORY_DIR at a directory containing kb/."
      ;;
    default-missing)
      echo "  No project memory at $PROJECT_MEMORY_DIR/kb."
      echo "  Opt in once: mkdir -p '$PROJECT_MEMORY_DIR/kb'. This tool does not create it for you."
      ;;
    same-as-personal)
      echo "  $PROJECT_MEMORY_DIR is the personal memory directory. That is not a second tier."
      ;;
    inside-personal)
      echo "  $PROJECT_MEMORY_DIR is inside the personal memory directory ($PROJECT_MEMORY_PERSONAL)."
      echo "  That is an org tier or part of yours, and org tiers get committed and pushed. Not a project tier."
      ;;
    contains-personal)
      echo "  $PROJECT_MEMORY_DIR contains the personal memory directory ($PROJECT_MEMORY_PERSONAL)."
      echo "  Committing the tier would commit your personal memory, and config.toml next to it. Move the config dir out of the repo."
      ;;
    org-overlap)
      echo "  The org tier $PROJECT_MEMORY_PERSONAL resolves to $PROJECT_MEMORY_LINK, which overlaps $PROJECT_MEMORY_DIR."
      echo "  sleep and mem-share would rewrite and push project files as org memory. Untangle the two."
      ;;
    symlink)
      echo "  $PROJECT_MEMORY_LINK is a symlink to '$(readlink "$PROJECT_MEMORY_LINK" 2>/dev/null || true)'."
      echo "  Project memory is files in the repo, not pointers out of it. Replace the link with the real thing."
      echo "  Until then the tier is neither read nor written."
      ;;
  esac
}
